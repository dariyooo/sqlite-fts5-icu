# Pinned upstream sources. Bump a version and its checksum together.
#
# ICU ships its data twice: icu4c-*-sources.tgz carries a prebuilt icudt*.dat,
# icu4c-*-data.zip carries the text the data is generated from. Only the second
# can be filtered, so the build overwrites source/data with it.
#
# SQLite is needed for headers only. A loadable extension built against these
# headers works with any SQLite at or above this version, so this pin does not
# have to track the one an app links.

ICU_RELEASE=78.3
ICU_MAJOR=78
ICU_SOURCES_SHA256=3a2e7a47604ba702f345878308e6fefeca612ee895cf4a5f222e7955fabfe0c0
ICU_DATA_SHA256=9d8b3899096aeb83e4e21ef8a40fec9e03b28db18c48452efac882ce25a91e27

SQLITE_RELEASE=3.50.2
SQLITE_AMALGAMATION=sqlite-amalgamation-3500200
SQLITE_AMALGAMATION_URL=https://sqlite.org/2025/sqlite-amalgamation-3500200.zip
SQLITE_AMALGAMATION_SHA256=387991de2834b5da2894119ff4173a9ea0779ea55ebcf53d9a40b24d1dc2484e
FTS5_H_SHA256=172dee881fb9905a825d51efaeb903cf9fc247262db54ca4c4b13de580f0fad4
